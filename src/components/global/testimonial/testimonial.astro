---
import MarkdownIt from "markdown-it";
import TestimonialItem from "./testimonial-item.astro";
const md = new MarkdownIt({ html: true });

// Define TypeScript interfaces
interface Testimonial {
  _uuid: string;
  image: string;
  image_alt: string;
  author: string;
  designation: string;
  message: string;
}

interface Props {
  title: string;
  title_suffix: string;
  description: string;
  testimonials: Testimonial[];
}

const { title, title_suffix, description, testimonials } = Astro.props;
---

<section
  class="bg-black relative border-b border-gray-800 sm:border-b-0 overflow-hidden py-16 lg:py-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center">
      <div class="lg:w-2/3 mx-auto text-center mb-12 lg:mb-16">
        <div class="testimonial-content pr-12 xl:pr-0 lg:text-center lg:pb-12">
          <h2
            class="text-white text-3xl sm:text-4xl xl:text-5xl font-bold mb-5 leading-tight"
          >
            <editable-text data-prop="title" data-rosey="testimonial:title" data-type="span"
              >{title}</editable-text
            >
            <span
              class="text-primary"
              data-editable="text"
              data-prop="title_suffix"
              data-rosey="testimonial:title_suffix"
            >
              {title_suffix}
            </span>
          </h2>
          <div
            class="text-xl md:text-2xl text-gray-300 font-medium leading-relaxed tracking-tight"
            data-editable="text"
            data-prop="description"
            data-rosey="testimonial:description"
            set:html={md.render(description)}
          />
        </div>
      </div>
    </div>
    {
      testimonials?.length && (
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
          data-editable="array"
          data-prop="testimonials"
        >
          {testimonials?.map((testimonial: Testimonial) => (
            <div data-editable="array-item" data-component="global/testimonial-item">
              <TestimonialItem {...testimonial} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
